{
  "name": "@tooark/core",
  "version": "1.0.0",
  "description": "Design system core (Web Components nativos + Tailwind v4)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tooark/tokens": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
