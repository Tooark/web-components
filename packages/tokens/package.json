{
  "name": "@tooark/tokens",
  "version": "1.0.0",
  "description": "Design tokens do Tooark (primitivas de design: intents, sizes, themes, variants + CSS @theme)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./tokens.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": {
      "default": "./tokens.css"
    }
  },
  "files": [
    "NOTICE",
    "dist",
    "tokens.css"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
