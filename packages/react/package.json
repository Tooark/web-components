{
  "name": "@tooark/react",
  "version": "1.1.0",
  "description": "Tooark React — typed wrappers for ark-* components for React 18 and 19",
  "keywords": [
    "tooark",
    "web-components",
    "custom-elements",
    "design-system",
    "tailwindcss",
    "react",
    "react-components",
    "wrappers"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Paulo Sergio de Freitas Junior",
    "email": "paulo.freitas@tooark.com",
    "url": "https://paulofreitas.tooark.com"
  },
  "homepage": "https://github.com/Tooark/web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tooark/web-components.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Tooark/web-components/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/paulosfjunior"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/paulosfjunior"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "README.pt-BR.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node postbuild.mjs",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tooark/core": "workspace:^",
    "@tooark/web-components": "workspace:^"
  }
}
