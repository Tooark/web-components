{
  "name": "@tooark/motion",
  "version": "1.0.0",
  "description": "Tooark Motion — opt-in animation helpers (stagger, scroll reveal, FLIP, swipe) on top of the Motion lib, with design system tokens",
  "keywords": [
    "tooark",
    "web-components",
    "custom-elements",
    "design-system",
    "tailwindcss",
    "motion",
    "animation",
    "flip",
    "stagger",
    "scroll-reveal"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Paulo Sergio de Freitas Junior",
    "email": "paulo.freitas@tooark.com",
    "url": "https://paulofreitas.tooark.com"
  },
  "homepage": "https://github.com/Tooark/web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tooark/web-components.git",
    "directory": "packages/motion"
  },
  "bugs": {
    "url": "https://github.com/Tooark/web-components/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/paulosfjunior"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/paulosfjunior"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "NOTICE",
    "README.pt-BR.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tooark/core": "workspace:^",
    "@tooark/tokens": "workspace:^",
    "motion": "^13.4.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
