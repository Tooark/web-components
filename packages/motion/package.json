{
  "name": "@tooark/motion",
  "version": "1.0.0",
  "description": "Tooark Motion — Camada 3 do sistema de motion: stagger, scroll reveal, FLIP e swipe baseados na lib Motion (motion.dev)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tooark/core": "workspace:*",
    "@tooark/tokens": "workspace:*",
    "motion": "^13.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
