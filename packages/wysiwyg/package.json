{
  "name": "@tooark/wysiwyg",
  "version": "0.1.0",
  "description": "Tooark WYSIWYG — editor e viewer (Custom Elements) baseados em Tiptap",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tooark/tokens": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2"
  }
}
