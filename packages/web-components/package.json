{
  "name": "@tooark/web-components",
  "version": "0.1.0",
  "description": "Tooark Web Components (Custom Elements nativos baseados em @tooark/core)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tooark/core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2"
  }
}
