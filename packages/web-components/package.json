{
  "name": "@tooark/web-components",
  "version": "1.0.0",
  "description": "Tooark Web Components — Custom Elements ark-* (botoes, campos, dialogos, menus, calendario, editor chave/valor...) com Tailwind v4 e tokens",
  "keywords": [
    "tooark",
    "web-components",
    "custom-elements",
    "design-system",
    "tailwindcss",
    "ui",
    "components",
    "accessibility",
    "popover-api",
    "lit-free"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Paulo Sergio de Freitas Junior",
    "email": "paulo.freitas@tooark.com",
    "url": "https://paulofreitas.tooark.com"
  },
  "homepage": "https://github.com/Tooark/web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tooark/web-components.git",
    "directory": "packages/web-components"
  },
  "bugs": {
    "url": "https://github.com/Tooark/web-components/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/paulosfjunior"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/paulosfjunior"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "NOTICE",
    "README.pt-BR.md",
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rollup -c && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && node ../../scripts/check-css.mjs dist/styles.css --min-bytes 20000 --expect --ark-duration-default --ark-color-primary: --ark-text-2xs: light-dark( ark-fade-in --expect-class ark:inline-flex ark:hover:bg-primary-hover \"ark:min-h-(--ark-size-md)\"",
    "dev": "rollup -c -w",
    "dev:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tooark/core": "workspace:^",
    "@tooark/tokens": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
