{
  "name": "@tooark/chart",
  "version": "0.1.0",
  "description": "Tooark Chart — Custom Element <ark-chart> baseado em ECharts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "echarts": ">=5"
  },
  "dependencies": {
    "@tooark/tokens": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "echarts": "^6.1.0"
  }
}
