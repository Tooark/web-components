{
  "name": "@tooark/code",
  "version": "1.0.0",
  "description": "Tooark Code — Custom Element <ark-code-editor> baseado em CodeMirror 6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6",
    "@codemirror/commands": ">=6",
    "@codemirror/lang-javascript": ">=6",
    "@codemirror/lang-json": ">=6",
    "@codemirror/lang-yaml": ">=6",
    "@codemirror/language": ">=6",
    "@codemirror/search": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6",
    "@lezer/highlight": ">=1"
  },
  "dependencies": {
    "@tooark/tokens": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.20.1"
  }
}
