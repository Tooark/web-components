{
  "name": "@tooark/code",
  "version": "1.1.0",
  "description": "Tooark Code — a code editor (`<ark-code-editor>`) based on CodeMirror 6 (supporting JSON, JavaScript, and YAML), featuring code completion, formatting, and token-based theming",
  "keywords": [
    "tooark",
    "web-components",
    "custom-elements",
    "design-system",
    "tailwindcss",
    "code-editor",
    "codemirror",
    "json",
    "yaml",
    "javascript"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Paulo Sergio de Freitas Junior",
    "email": "paulo.freitas@tooark.com",
    "url": "https://paulofreitas.tooark.com"
  },
  "homepage": "https://github.com/Tooark/web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tooark/web-components.git",
    "directory": "packages/code"
  },
  "bugs": {
    "url": "https://github.com/Tooark/web-components/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/paulosfjunior"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/paulosfjunior"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "NOTICE",
    "README.pt-BR.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6",
    "@codemirror/commands": ">=6",
    "@codemirror/lang-javascript": ">=6",
    "@codemirror/lang-json": ">=6",
    "@codemirror/lang-yaml": ">=6",
    "@codemirror/language": ">=6",
    "@codemirror/search": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6",
    "@lezer/highlight": ">=1"
  },
  "dependencies": {
    "@tooark/tokens": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^26.6.1"
  }
}
