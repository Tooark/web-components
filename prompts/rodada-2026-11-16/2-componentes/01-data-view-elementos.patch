+function doc(category: string, description: string, type: string, defaultValue?: string) {
+  return {
+    control: false as const,
+    description,
+    table: {
+      category,
+      type: { summary: type },
+      ...(defaultValue === undefined ? {} : { defaultValue: { summary: defaultValue } })
+    }
+  };
+}
