+      size,
+      layout,
+      columns,
+      entries: computed.entries,
+      label,
+      selectable: this.selectable,
+      reorderable,
+      // Uma lista ordenada ou filtrada não tem ordem manual para mudar.
+      canReorder: reorderable && !sort && !this.search.trim() && !loading,
+      clickable: this.clickable
