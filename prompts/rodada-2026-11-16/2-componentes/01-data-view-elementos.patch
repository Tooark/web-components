+  }
+};
+
+// Sem registros: o ark-empty próprio ("Nenhuma entrada", ou "Nenhum resultado" numa busca); um filho
+// `slot="empty"` do app toma o lugar dele e só aparece nesse estado.
+export const EmptyStates = {
