diff --git a/packages/web-components/src/styles/components.css b/packages/web-components/src/styles/components.css
index bca685e1a2733183a04b172543714205099a9747..47b393931c8f8819e9cdb9bc76e3261bbaab1893 100644
--- a/packages/web-components/src/styles/components.css
+++ b/packages/web-components/src/styles/components.css
@@ -753,4 +753,184 @@
     pointer-events: none;
     user-select: none;
   }
+
+  /* ---------- ark-data-view: grid barra de ferramentas / seleção / conteúdo / paginação ---------- */
+
+  /*
+   * Os nós do componente (busca, ordenação, seletor de visualização, barra de
+   * seleção, conteúdo, rodapé) se encaixam em volta dos slots do usuário
+   * (toolbar, selection, empty), que ficam onde estão: quem põe cada um no
+   * lugar é esta grid. O espaço entre as linhas é margem dos itens, e não
+   * row-gap, porque uma linha sem itens (sem busca nem seleção) não pode
+   * deixar vão.
+   */
+  ark-data-view {
+    --ark-data-view-gap: 0.75rem;
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto auto auto;
+    align-items: center;
+    column-gap: 0.5rem;
+  }
+
+  ark-data-view > [data-ark-chrome="search"] {
+    grid-area: 1 / 1;
+    justify-self: start;
+    width: min(100%, 20rem);
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  ark-data-view > [data-ark-chrome="sort"] {
+    grid-area: 1 / 2;
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  /* Ações do usuário ao lado da busca (um container, como o rodapé do dialog). */
+  ark-data-view > [slot="toolbar"] {
+    grid-area: 1 / 3;
+    display: inline-flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 0.5rem;
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  ark-data-view > [data-ark-chrome="views"] {
+    grid-area: 1 / 4;
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  ark-data-view > [data-ark-chrome="selection"] {
+    grid-area: 2 / 1;
+    min-height: var(--ark-size-sm, 1.75rem);
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  /* Ações em massa do usuário: só enquanto há seleção. */
+  ark-data-view > [slot="selection"] {
+    grid-area: 2 / 2 / auto / -1;
+    justify-self: end;
+    display: inline-flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 0.5rem;
+    margin-bottom: var(--ark-data-view-gap);
+  }
+
+  ark-data-view:not([data-ark-selecting]) > [slot="selection"] {
+    display: none;
+  }
+
+  ark-data-view > [data-ark-chrome="content"],
+  ark-data-view > [slot="empty"] {
+    grid-area: 3 / 1 / auto / -1;
+    min-width: 0;
+  }
+
+  /* Estado vazio do usuário: só quando não há registros (o componente esconde o próprio conteúdo). */
+  ark-data-view:not([data-ark-empty]) > [slot="empty"] {
+    display: none;
+  }
+
+  ark-data-view > [data-ark-chrome="footer"] {
+    grid-area: 4 / 1 / auto / -1;
+    margin-top: var(--ark-data-view-gap);
+  }
+
+  /* Estreito: a busca ocupa a primeira linha com o seletor de visualização, e o resto empilha abaixo. */
+  ark-data-view[data-ark-narrow] > [data-ark-chrome="search"] {
+    grid-area: 1 / 1 / auto / 4;
+    width: 100%;
+  }
+
+  ark-data-view[data-ark-narrow] > [data-ark-chrome="sort"] {
+    grid-area: 2 / 1 / auto / 3;
+    justify-self: start;
+  }
+
+  ark-data-view[data-ark-narrow] > [slot="toolbar"] {
+    grid-area: 2 / 3 / auto / -1;
+  }
+
+  ark-data-view[data-ark-narrow] > [data-ark-chrome="selection"] {
+    grid-area: 3 / 1 / auto / -1;
+  }
+
+  ark-data-view[data-ark-narrow] > [slot="selection"] {
+    grid-area: 4 / 1 / auto / -1;
+    justify-self: start;
+    justify-content: flex-start;
+  }
+
+  ark-data-view[data-ark-narrow] > [data-ark-chrome="content"],
+  ark-data-view[data-ark-narrow] > [slot="empty"] {
+    grid-area: 5 / 1 / auto / -1;
+  }
+
+  ark-data-view[data-ark-narrow] > [data-ark-chrome="footer"] {
+    grid-area: 6 / 1 / auto / -1;
+  }
+
+  /*
+   * Reordenação: a marca de onde o registro vai entrar é uma linha na cor
+   * primary. Na tabela, uma sombra interna nas células (num <tr> ela não
+   * desenha); nos cards, um ::after no meio do vão entre eles, em pé na borda
+   * do card quando estão lado a lado e deitado quando estão empilhados numa
+   * coluna só (data-ark-drop-stacked, medido pelo componente). O registro
+   * arrastado esmaece. Durante o arrasto nada seleciona texto.
+   */
+  ark-data-view[data-ark-dragging] {
+    cursor: grabbing;
+    user-select: none;
+  }
+
+  ark-data-view [data-ark-drag-source] {
+    opacity: 0.5;
+  }
+
+  ark-data-view tr[data-ark-drop="before"] > td {
+    box-shadow: inset 0 2px 0 0 var(--ark-color-primary);
+  }
+
+  ark-data-view tr[data-ark-drop="after"] > td {
+    box-shadow: inset 0 -2px 0 0 var(--ark-color-primary);
+  }
+
+  /* O vão entre os cards é o gap-3 da lista (0.75rem): a linha de 3px fica no meio dele. */
+  ark-data-view li[data-ark-drop]::after {
+    content: "";
+    position: absolute;
+    top: 0;
+    bottom: 0;
+    width: 3px;
+    border-radius: 9999px;
+    background-color: var(--ark-color-primary);
+    pointer-events: none;
+  }
+
+  ark-data-view li[data-ark-drop="before"]::after {
+    left: calc(-0.375rem - 2.5px);
+  }
+
+  ark-data-view li[data-ark-drop="after"]::after {
+    right: calc(-0.375rem - 2.5px);
+  }
+
+  ark-data-view[data-ark-drop-stacked] li[data-ark-drop]::after {
+    top: auto;
+    bottom: auto;
+    left: 0;
+    right: 0;
+    width: auto;
+    height: 3px;
+  }
+
+  ark-data-view[data-ark-drop-stacked] li[data-ark-drop="before"]::after {
+    top: calc(-0.375rem - 2.5px);
+  }
+
+  ark-data-view[data-ark-drop-stacked] li[data-ark-drop="after"]::after {
+    bottom: calc(-0.375rem - 2.5px);
+  }
 }
