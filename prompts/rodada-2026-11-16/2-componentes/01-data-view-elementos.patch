+    }
+    this.ownClasses = next;
+    this.syncingClass = false;
+  }
+
+  private updateAppearance(): void {
+    if (
+      !this.searchEl ||
+      !this.sortEl ||
+      !this.viewsEl ||
+      !this.selectionEl ||
+      !this.selectionAllEl ||
+      !this.selectionCountEl ||
+      !this.clearEl ||
+      !this.contentEl ||
+      !this.footerEl ||
+      !this.paginationEl
